OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
AMADEUS_POSTGRES_DSN=postgresql://amadeus:amadeus@localhost:5432/amadeus
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_TOKENS=2048
# AMADEUS_SESSION_KEY=cli:default
# AMADEUS_MEMORY_KEEP_COUNT=12
# AMADEUS_LONG_TERM_MEMORY_ENABLED=0
# AMADEUS_MEMORY_USER_ID=1
# OPENAI_EMBEDDING_MODEL=text-embedding-v4
# AMADEUS_LONG_TERM_MEMORY_TOP_K=8
# AMADEUS_MEMORY_HYPOTHESIS_RETRIEVAL_ENABLED=1
# AMADEUS_MEMORY_HYPOTHESIS_TIMEOUT_SECONDS=2.0
# OPENAI_LIGHT_MODEL=gpt-4.1-mini
# Runtime data defaults to ~/.amadeus/workspace unless --workspace-root is passed.
