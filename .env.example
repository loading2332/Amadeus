OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
# Public HTTPS URL and GitHub OAuth App credentials. The callback URL is
# ${AMADEUS_PUBLIC_BASE_URL}/auth/github/callback.
AMADEUS_PUBLIC_BASE_URL=https://amadeus.example.com
AMADEUS_GITHUB_CLIENT_ID=replace-me
AMADEUS_GITHUB_CLIENT_SECRET=replace-me
# At least 32 random characters; never commit the production value.
AMADEUS_JWT_SECRET=replace-me-replace-me-replace-me-replace-me
# AMADEUS_JWT_ISSUER=amadeus
# AMADEUS_JWT_AUDIENCE=amadeus-web
AMADEUS_POSTGRES_DSN=postgresql://amadeus:amadeus@localhost:5432/amadeus
# 仅供旧单用户 CLI 入口使用；公网 Web/worker 的身份来自 JWT 与 turn.user_id。
# AMADEUS_OWNER_USER_ID=1
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_TOKENS=2048
# AMADEUS_MEMORY_KEEP_COUNT=12
# 默认每 18 小时按 Unix 时间边界整理 PENDING.md 到 MEMORY.md。
# AMADEUS_MEMORY_OPTIMIZER_ENABLED=1
# AMADEUS_MEMORY_OPTIMIZER_INTERVAL_SECONDS=64800
# AMADEUS_LONG_TERM_MEMORY_ENABLED=0
# AMADEUS_TURN_STREAM_FLUSH_CHARACTERS=128
# AMADEUS_TURN_STREAM_FLUSH_INTERVAL_SECONDS=0.1
# AMADEUS_TURN_HEARTBEAT_INTERVAL_SECONDS=10
# AMADEUS_TURN_STALE_AFTER_SECONDS=120
# turn worker 与 post-response memory worker 共用以上 heartbeat/stale 租约配置。
# OPENAI_EMBEDDING_MODEL=text-embedding-v4
# AMADEUS_LONG_TERM_MEMORY_TOP_K=8
# AMADEUS_MEMORY_LEXICAL_RETRIEVAL_ENABLED=1
# AMADEUS_MEMORY_HYPOTHESIS_RETRIEVAL_ENABLED=1
# AMADEUS_MEMORY_HYPOTHESIS_TIMEOUT_SECONDS=2.0
# OPENAI_LIGHT_MODEL=gpt-4.1-mini
# Runtime data defaults to ~/.amadeus/workspace unless --workspace-root is passed.
